APP_NAME="Support Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost

ASSET_URL=http://localhost

LIVEWIRE_SUBDIRECTORY=
# example /support

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database


BCRYPT_ROUNDS=12


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# Optional: AWS Storage

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


#CDN URL ex AWS CLOUDFRONT
CDN_URL=


# Social Login (Optional)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID= 
GITHUB_CLIENT_SECRET=


# Google reCAPTCHA v3 (Optional)

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5


# Email Ticket Replies

# Domain used for reply+token@example.com
SUPPORT_REPLY_DOMAIN="your-domain.com"

# Maximum upload size in KB
SUPPORT_MAX_ATTACHMENT_KB=5120

# Secret used to validate inbound email webhooks
INBOUND_WEBHOOK_SECRET=

# AI Provider Settings
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_PROVIDER_ACCOUNT_ID=
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Custom Login Security (Optional, set to 1 to enable ripemd256 hmac hashing)
CUSTOM_LOGIN_SECURITY=


# ─── Payment Processors ───────────────────────────────────────────────────
# Configure credentials for the processor(s) you enable.
# The admin panel (Checkout → Processors) controls which processor is active
# and whether sandbox or production mode is used per processor.

# Stripe  (processor_id = 1)
# Get keys at: https://dashboard.stripe.com/developers
# Webhook:      https://dashboard.stripe.com/webhooks → Add endpoint → https://yourdomain.com/webhooks/stripe
# Uncomment and fill in when enabling Stripe in config/payment_processors.php
#
# STRIPE_PUBLISHABLE_KEY=pk_live_
# STRIPE_SECRET_KEY=sk_live_
# STRIPE_SANDBOX_PUBLISHABLE_KEY=pk_test_
# STRIPE_SANDBOX_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_


# Paddle  (processor_id = 2)
# Get keys at: https://vendors.paddle.com/developer-tools/auth  (live)
#              https://sandbox-vendors.paddle.com/developer-tools/auth  (sandbox)
# Webhook:     Paddle Dashboard → Developer Tools → Notifications → https://yourdomain.com/webhooks/paddle
# Uncomment and fill in when enabling Paddle in config/payment_processors.php
#
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_SANDBOX_API_KEY=
# PADDLE_SANDBOX_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=


# PayPal  (processor_id = 3)
# Get keys at: https://developer.paypal.com/dashboard/applications/
# Uncomment and fill in when enabling PayPal in config/payment_processors.php
#
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
