# ==========================================================
# Laravel Application
# ==========================================================

APP_NAME="eCommerce Site"

APP_ENV=production

APP_KEY=

APP_DEBUG=false

APP_URL=https://example.com

# If installed in a subdirectory:
# APP_URL=https://example.com/sub-dir-name

ASSET_URL=https://example.com

LIVEWIRE_SUBDIRECTORY=
# example /sub-dir-name


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


# ==========================================================
# Logging
# ==========================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning


# ==========================================================
# Database
# ==========================================================

DB_CONNECTION=mysql

DB_HOST=127.0.0.1

DB_PORT=3306

DB_DATABASE=database_name

DB_USERNAME=database_user

DB_PASSWORD=database_password


# ==========================================================
# Sessions / Cache / Queue
# ==========================================================

SESSION_DRIVER=database

SESSION_LIFETIME=120

SESSION_ENCRYPT=false

SESSION_PATH=/

SESSION_DOMAIN=.example.com


CACHE_STORE=database

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log


# ==========================================================
# Filesystem
# ==========================================================

FILESYSTEM_DISK=local


# For S3 / Cloud Storage:

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_DEFAULT_REGION=us-east-1

AWS_BUCKET=

AWS_USE_PATH_STYLE_ENDPOINT=false

#CDN URL ex AWS CLOUDFRONT
CDN_URL=


# ==========================================================
# Mail Configuration
# ==========================================================
#
# Example using Mailgun SMTP
#

MAIL_MAILER=smtp

MAIL_SCHEME=smtp

MAIL_HOST=smtp.mailgun.org

MAIL_PORT=587

MAIL_USERNAME=postmaster@mg.example.com

MAIL_PASSWORD=CHANGE_THIS_PASSWORD

MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=support@example.com

MAIL_FROM_NAME="Support Tickets"


# ==========================================================
# Social Login
# ==========================================================
#
# Optional
#

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=


FACEBOOK_CLIENT_ID=

FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID= 
GITHUB_CLIENT_SECRET=


# ==========================================================
# Google reCAPTCHA v3
# ==========================================================
#
# Recommended for registration protection
#

RECAPTCHA_SITE_KEY=

RECAPTCHA_SECRET_KEY=

RECAPTCHA_THRESHOLD=0.5


# ==========================================================
# Email Reply Ticket Ingestion
# ==========================================================
#
# Used for:
# reply+token@example.com
#

SUPPORT_REPLY_DOMAIN="example.com"

SUPPORT_MAX_ATTACHMENT_KB=5120


# Used to validate inbound webhook requests

INBOUND_WEBHOOK_SECRET=CHANGE_TO_LONG_RANDOM_SECRET


# AI Provider Settings
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_PROVIDER_ACCOUNT_ID=
OPENAI_API_KEY=


# Custom Login Security (Optional, set to 1 to enable ripemd256 hmac hashing)
CUSTOM_LOGIN_SECURITY=

# ==========================================================
# Payment Processor Settings
# ==========================================================

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SANDBOX_PUBLISHABLE_KEY=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=


# ==========================================================
# Vite
# ==========================================================

VITE_APP_NAME="${APP_NAME}"